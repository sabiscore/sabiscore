{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "env": {
    "NODE_ENV": "development",
    "TURBO_TELEMETRY_DISABLED": "1",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "attribution": {
    "commit": "Co-authored-by: SCAR (Claude Code) <claude@anthropic.com>",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm --filter:*)",
      "Bash(npx tsc:*)",
      "Bash(npx prettier:*)",
      "Bash(node:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3.12 -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(python3.12 -c:*)",
      "Bash(.venv/bin/python -c:*)",
      "Bash(.venv/Scripts/python.exe -c:*)",
      "Bash(.venv/bin/python scripts/:*)",
      "Bash(.venv/Scripts/python.exe scripts/:*)",
      "Bash(make validate:*)",
      "Bash(make doctor:*)",
      "Bash(curl -s:*)",
      "Bash(find . -type f:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(npx --yes * | bash:*)",
      "Bash(DROP TABLE:*)",
      "Bash(DELETE FROM:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(pnpm db:migrate:*)",
      "Bash(pnpm db:push:*)",
      "Bash(pnpm db:seed:*)",
      "Bash(make install:*)",
      "Bash(sh install.sh:*)",
      "Bash(bash install.sh:*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": []
  },
  "model": "claude-sonnet-4-6",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-dangerous-command.cjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report-file-change.cjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.cjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
