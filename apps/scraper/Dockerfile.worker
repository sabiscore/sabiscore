FROM node:22-bookworm-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/scraper/package.json ./apps/scraper/package.json
RUN pnpm install --frozen-lockfile --filter @sabiscore/scraper...

COPY backend/requirements.worker.txt ./backend/requirements.worker.txt
RUN python3 -m venv /opt/sabiscore-worker \
    && /opt/sabiscore-worker/bin/pip install --no-cache-dir -r backend/requirements.worker.txt

COPY apps/scraper ./apps/scraper
COPY backend/src ./backend/src
COPY backend/alembic ./backend/alembic
COPY backend/alembic.ini ./backend/alembic.ini
COPY apps/scraper/run-production-worker.sh ./apps/scraper/run-production-worker.sh

RUN useradd --create-home --uid 10001 worker \
    && mkdir -p /app/data \
    && chown -R worker:worker /app/data /app/apps/scraper

USER worker
CMD ["/bin/sh", "/app/apps/scraper/run-production-worker.sh"]
