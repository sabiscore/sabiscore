{
  "registryVersion": "2.0.0",
  "sources": {
    "footballData": {
      "id": "football-data-csv",
      "baseUrl": "https://www.football-data.co.uk",
      "type": "csv",
      "enabled": true,
      "transport": "static-http",
      "purpose": "Historical fixtures, results, coherent bookmaker 1X2 prices, and team form",
      "allowedDomains": ["www.football-data.co.uk"],
      "allowedUrlPatterns": ["/mmz4281/{season}/{league}.csv"],
      "collectedFields": ["fixtures", "results", "closing_1x2_odds", "team_form"],
      "termsReviewStatus": "reviewed_public_csv_operator_reapproval_required_for_production",
      "robotsPolicy": "enforce",
      "attribution": "football-data.co.uk",
      "cadence": "0 3 * * 1,4",
      "freshnessExpectationSeconds": 345600,
      "concurrency": 1,
      "maxRequestsPerMinute": 6,
      "sameDomainDelaySeconds": 3,
      "timeoutMs": 20000,
      "maxRetries": 2,
      "parserVersion": "2.0.0",
      "schemaVersion": "2.0.0",
      "supportedEnvironments": ["development", "staging", "production"],
      "productionActivation": "operator_approval_required",
      "owner": "data-engineering",
      "killSwitchEnv": "DISABLE_FOOTBALL_DATA_CSV"
    },
    "clubElo": {
      "id": "clubelo-public",
      "baseUrl": "https://api.clubelo.com",
      "type": "csv",
      "enabled": false,
      "transport": "static-http",
      "purpose": "Elo ratings pending source and licence review",
      "allowedDomains": ["api.clubelo.com"],
      "allowedUrlPatterns": ["/{date}"],
      "collectedFields": ["elo_ratings"],
      "termsReviewStatus": "disabled_pending_review",
      "robotsPolicy": "disabled_until_reviewed",
      "attribution": "clubelo.com",
      "cadence": "manual",
      "freshnessExpectationSeconds": 86400,
      "concurrency": 1,
      "maxRequestsPerMinute": 1,
      "sameDomainDelaySeconds": 60,
      "timeoutMs": 20000,
      "maxRetries": 0,
      "parserVersion": "1.0.0",
      "schemaVersion": "1.0.0",
      "supportedEnvironments": [],
      "productionActivation": "disabled",
      "owner": "data-engineering",
      "killSwitchEnv": "DISABLE_CLUBELO_PUBLIC"
    }
  },
  "competitions": {
    "EPL": "E0",
    "UCL": "CL",
    "LA_LIGA": "SP1",
    "SERIE_A": "I1",
    "BUNDESLIGA": "D1",
    "LIGUE_1": "F1",
    "EREDIVISIE": "N1"
  }
}
