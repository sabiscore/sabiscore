{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabiscore.com/schemas/scraper-source-registry-v2.json",
  "type": "object",
  "required": ["registryVersion", "sources", "competitions"],
  "properties": {
    "registryVersion": { "type": "string", "pattern": "^2\\." },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id", "baseUrl", "type", "enabled", "transport", "purpose",
          "allowedDomains", "allowedUrlPatterns", "collectedFields",
          "termsReviewStatus", "robotsPolicy", "attribution", "cadence",
          "freshnessExpectationSeconds", "concurrency", "maxRequestsPerMinute",
          "sameDomainDelaySeconds", "timeoutMs", "maxRetries", "parserVersion",
          "schemaVersion", "supportedEnvironments", "productionActivation",
          "owner", "killSwitchEnv"
        ],
        "properties": {
          "baseUrl": { "type": "string", "pattern": "^https://" },
          "allowedDomains": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "allowedUrlPatterns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "concurrency": { "type": "integer", "minimum": 1, "maximum": 2 },
          "maxRequestsPerMinute": { "type": "integer", "minimum": 1 },
          "timeoutMs": { "type": "integer", "minimum": 1000 },
          "maxRetries": { "type": "integer", "minimum": 0, "maximum": 3 }
        },
        "additionalProperties": true
      }
    },
    "competitions": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
